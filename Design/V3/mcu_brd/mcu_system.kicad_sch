	(text "U1 port I, DSI, reset, boot"
		(exclude_from_sim no)
		(at 16.51 16.3 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "11ef24e5-2c70-50e7-a623-95210521ad1d")
	)
	(text "25 MHz HSE: ABM8-25.000MHZ-10-D1G-T"
		(exclude_from_sim no)
		(at 106.39 16.3 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1a1be105-7c5e-5273-a83a-ec2f9c34f3ab")
	)
	(text "CL 10 pF, ESR 50 ohm max, C0 3 pF max, 100 uW max."
		(exclude_from_sim no)
		(at 106.39 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b171783b-9e59-5e93-b667-02e754ce6781")
	)
	(text "gm_crit = 4 x 50 x (2 pi 25 MHz)^2 x (3 pF + 10 pF)^2 = 0.83 mA/V, limit 1.5 mA/V (DS12930 Table 43)."
		(exclude_from_sim no)
		(at 106.39 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a02a791a-4b60-5094-a35b-bebc7f729079")
	)
	(text "CL1 = CL2 = 2 x (CL - Cs) = 2 x (10 - 3.5) = 13 pF. Cs = (5 pF pin + 2 pF PCB) / 2."
		(exclude_from_sim no)
		(at 106.39 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "77d942b4-dd5d-53b4-8dc8-ca83fe2a41a3")
	)
	(text "R is 0 ohm. Raise it only if measured drive level exceeds 100 uW."
		(exclude_from_sim no)
		(at 106.39 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "81ecffbf-c1e2-51fd-b6b3-b64bee2631db")
	)
