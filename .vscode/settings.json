{
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "xaver.clang-format",
    "clang-format.executable": "C:/Program Files (x86)/LLVM_Clang/bin/clang-format",
    "workbench.editor.wrapTabs": true,

    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.compilerPath": "${workspaceFolder}/Tools/msys/mingw64/bin/arm-none-eabi-gcc.exe",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.cppStandard": "gnu++17",
    "C_Cpp.default.intelliSenseMode": "gcc-arm",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.enhancedColorization": "enabled",
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "C_Cpp.codeAnalysis.clangTidy.path": "C:/Program Files (x86)/LLVM_Clang/bin/clang-tidy",
    "C_Cpp.codeAnalysis.clangTidy.args": [
        "--config-file=${workspaceFolder}/.clang-tidy"
    ],
    "C_Cpp.errorSquiggles": "enabled",
    "cmake.ignoreCMakeListsMissing": true,
    "git.ignoreLimitWarning": true,

    "terminal.integrated.profiles.windows": {
        "Flapjack": {
            "path": "C:\\Program Files\\Git\\bin\\bash.exe",
            // "args": [
            //     "-c",
            //     "source Scripts/config.bash && exec bash"
            // ],
            "cwd": "${workspaceFolder}"
        }
    },
    "terminal.integrated.defaultProfile.windows": "Flapjack",

    "memory-view.trackDebuggers": [
        "stlinkgdbtarget",
    ],

    
