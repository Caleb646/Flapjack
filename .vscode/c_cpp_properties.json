{
    "configurations": [
        {
            "name": "Windows DEBUG",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/Firmware",
                "${workspaceFolder}/Firmware/target",
                "${workspaceFolder}/Firmware/inc",
                "${workspaceFolder}/Firmware/msgs/proto",
                "${workspaceFolder}/Firmware/msgs/umsg",
                "${workspaceFolder}/Firmware/platform",
                "${workspaceFolder}/Firmware/platform/stm32h747/cm4/inc",
                "${workspaceFolder}/Firmware/platform/stm32h747/cm7/inc",
                "${workspaceFolder}/Vendor/STM32H7/CMSIS/Include",
                "${workspaceFolder}/Vendor/STM32H7/STM32H7xx_HAL_Driver/Inc"
            ],
            "defines": [
                // "UNIT_TEST", // Uncomment for unit tests
                "DEBUG",
                "CORE_CM4",
                "CORE_CM7",
                "USE_HAL_DRIVER",
                "STM32H747xx",
                // "USE_PWR_DIRECT_SMPS_SUPPLY",
                "USE_PWR_LDO_SUPPLY",
                "BOARD_FLAPJACK_V1"
        ],
            "compilerPath": "${workspaceFolder}/Tools/msys/mingw64/bin/arm-none-eabi-gcc.exe",
            "cStandard": "c11",
            "intelliSenseMode": "gcc-arm",
            "configurationProvider": "none"
        },

        {
            "name": "Linux",
            "includePath": [
