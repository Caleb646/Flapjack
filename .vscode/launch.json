{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Unit Tests",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Tests/build/Debug/test_common.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Tests/build",
            "environment": [],
            "preLaunchTask": "build tests"
        },

        {
            "name": "Debug M7 Core",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/Build/${input:boardName}/Debug/m7core.elf",
            "loadFiles": [
                "${workspaceFolder}/Build/${input:boardName}/Debug/m7core.elf",
                "${workspaceFolder}/Build/${input:boardName}/Debug/m4core.elf",
            ],
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "armToolchainPath": "${workspaceFolder}/Tools/msys/mingw64/bin",
            "serverpath": "${workspaceFolder}/Tools/msys/mingw64/bin/openocd",
            "gdbPath": "${workspaceFolder}/Tools/msys/mingw64/bin/gdb-multiarch",
            "svdFile": "${workspaceFolder}/Vendor/STM32H7/STM32H747_CM7.svd",
            "device": "STM32H747XIHX",
            "showDevDebugOutput": "raw",
            "configFiles": ["interface/stlink.cfg", "target/stm32h7x_dual_bank.cfg"],
            //"configFiles": ["interface/stlink.cfg", "target/stm32h7x.cfg"],
            //"configFiles": ["${workspaceFolder}/Scripts/stm32h747_dual_core.cfg"],
            //"targetId": "stm32h7x.cpu0",
            // "runToEntryPoint": "main",
            "preLaunchTask": "build firmware debug",

            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 480000000,
                "source": "probe",
                "swoFrequency": 2000000,
                "decoders": [
                    { "type": "console", "label": "ITM Console", "port": 0, "encoding": "utf8" }
                ]
            },
        
            "numberOfProcessors": 2,
            "targetProcessor": 0,
            "chainedConfigurations": {
                "enabled": true,
                "waitOnEvent": "postInit",
                "detached": false,                         // Set this to true for JLink/STLink, false for most other type servers
                // "detached": true,                         // Set this to true for JLink/STLink, false for most other type servers
                "lifecycleManagedByParent": true,
                "launches": [                              // Array of launches. Order is respected
                    // {
                    //     "name": "Debug M4 Core",     // Name of another configuration
                    // }
                ]
            },
            // "serverArgs": [
            //     "-l", "1",
            //     "-m", "0", // option is used to indicate which Core the debugger will be connected
            //     "-k", // connect under reset
            //     "-t","-s" // indicate that the ST-LINK probe is shared
            // ],
            // "openOCDLaunchCommands": [
            //     "monitor reset halt",
            // ]
        },







        {
            "name": "Debug M4 Core", 
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/Build/${input:boardName}/Debug/m4core.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "armToolchainPath": "${workspaceFolder}/Tools/msys/mingw64/bin",
            "serverpath": "${workspaceFolder}/Tools/msys/mingw64/bin/openocd",
            "gdbPath": "${workspaceFolder}/Tools/msys/mingw64/bin/gdb-multiarch",
            "showDevDebugOutput": "raw",
            "configFiles": ["interface/stlink.cfg", "target/stm32h7x_dual_bank.cfg"],
            "targetId": "stm32h7x.cpu1",

            // "numberOfProcessors": 2,
            "targetProcessor": 1
            // "targetId": "stm32h7x.cpu1",
            // "runToEntryPoint": "main",
            // "preLaunchTask": "build firmware debug",
            // "postLaunchCommands": [
            //     "monitor halt",
            //     "load"
            // ]
        }
    ],
    "compounds": [
        {
            "name": "Debug M7 & M4 Cores",
            "configurations": ["Debug M7 Core", "Debug M4 Core"],
            "preLaunchTask": "build firmware debug"
        }
    ],

    "inputs": [
        {
            "id": "boardName",
            "description": "Select board",  
            "type": "pickString",
            "options": ["nucleo-h747zi", "flapjack-v1"],
        }
    ]
}