{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build tests",
            "type": "shell",
            "command": "cmake --build ./Tests/build --config Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "build firmware",
            "type": "shell",
            "command": "python3",
            "args": [
                "Scripts/board.py", "build",
                "--board", "${input:boardName}",
                "-f", "dgt"  
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "flash firmware",
            "type": "shell",
            "command": "python3",
            "args": [
                "Scripts/board.py", "flash",
                "--board", "${input:boardName}",
                "--config", "${input:buildConfig}"
            ],
            "dependsOn": "build firmware",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "flash firmware + run HIL tests",
            "type": "shell",
            "command": "python3",
            "args": [
                "Scripts/board.py", "flash",
                "--board", "${input:boardName}",
                "--config", "${input:buildConfig}",
                "--run-tests",
                "--port", "${input:serialPort}",
                "--baud", "${input:baudRate}"
            ],
            "dependsOn": "build firmware",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "install SDK",
            "type": "shell",
            "command": "python3",
            "args": ["Scripts/board.py", "install"],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "boardName",
            "description": "Select board",
            "type": "pickString",
            "options": ["nucleo-h747zi", "flapjack-v1"]
        },
        {
            "id": "buildConfig",
            "description": "Build configuration",
            "type": "pickString",
            "options": ["Debug", "Release"],
            "default": "Debug"
        },
        {
            "id": "serialPort",
            "description": "Serial port for UART output",
            "type": "promptString",
            "default": "/dev/ttyACM0"
        },
        {
            "id": "baudRate",
            "description": "Baud rate",
            "type": "pickString",
            "options": ["230400", "115200", "921600"],
            "default": "230400"
        }
    ]
}
