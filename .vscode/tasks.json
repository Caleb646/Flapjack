{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build tests",
            "type": "shell",
            "command": "cmake --build ./Tests/build --config Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "build firmware debug",
            "type": "shell",
            "command": "python", 
            "args": ["Scripts/fw_build.py", "${input:boardName}"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always", 
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        },

        {
            "label": "flash firmware",
            "type": "shell",
            "command": "${workspaceFolder}/Tools/msys/mingw64/bin/openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32h7x_dual_bank.cfg",
                "-c", "init",
                "-c", "reset halt",
                "-c", "flash write_image erase Build/${input:boardName}/Debug/m7core.elf",
                "-c", "flash write_image erase Build/${input:boardName}/Debug/m4core.elf",
                "-c", "reset run",
                "-c", "shutdown"
            ],
            "dependsOn": "build firmware debug",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "boardName",
            "description": "Select board",  
            "type": "pickString",
            "options": ["nucleo-h747zi", "flapjack-v1"],
        }
    ]
}
