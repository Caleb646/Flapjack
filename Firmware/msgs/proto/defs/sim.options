# nanopb field options: fixed-capacity arrays so structs are static (no heap).
# 3-vectors are always exactly 3 elements (no count field).
Telemetry.euler     max_count:3  fixed_count:true
Telemetry.nav_pos_ned max_count:3  fixed_count:true
Telemetry.nav_vel_ned max_count:3  fixed_count:true

# Variable-length: capacity sized to the largest board, actual count on the wire.
ServoCmd.angle      max_count:8
MotorCmd.throttle   max_count:8
