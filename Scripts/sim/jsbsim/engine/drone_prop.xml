<?xml version="1.0"?>
<!--
  STARTER fixed-pitch propeller. The C_THRUST / C_POWER coefficient tables vs
  advance ratio (J) are rough placeholders - tune to get sensible hover thrust.
  Not validated in this repo.
-->
<propeller name="drone_prop" version="1.0">
  <ixx>        0.0001 </ixx>
  <diameter unit="IN"> 10.0 </diameter>
  <numblades>  2 </numblades>
  <gearratio>  1.0 </gearratio>
  <minpitch>   10 </minpitch>
  <maxpitch>   10 </maxpitch>
  <minrpm>     0 </minrpm>
  <maxrpm>     35000 </maxrpm>
  <constspeed> 0 </constspeed>

  <table name="C_THRUST" type="internal">
    <tableData>
      0.0   0.105
      0.4   0.080
      0.8   0.030
      1.2  -0.010
    </tableData>
  </table>

  <table name="C_POWER" type="internal">
    <tableData>
      0.0   0.045
      0.4   0.044
      0.8   0.036
      1.2   0.020
    </tableData>
  </table>
</propeller>
