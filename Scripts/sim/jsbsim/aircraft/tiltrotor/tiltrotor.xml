<?xml version="1.0"?>
<!--
  Twin tilt-rotor FDM for the Flapjack SIL.

  Airframe: 0.85 kg all-up, two rotors at y = +/-0.25 m, 7 in props on 1000 KV
  motors. Sized for a thrust-to-weight of 2:1, so hover sits at 50% throttle.

  PROPULSION MODEL
  ================
  Thrust is applied through <external_reactions> rather than JSBSim's blade
  element propeller. The propeller model diverged: its advance ratio ran away
  (J reaching 1e8 within 0.05 s) regardless of thrust direction, and rpm was not
  clamped by maxrpm. For a SIL what is needed is thrust as a function of throttle
  along the tilt axis, which this expresses directly - no advance ratio, no rpm
  ODE, and table lookups clamp at their endpoints so nothing can run off the end.

  The trade is that genuine forward-flight propeller behaviour is approximated by
  a thrust-vs-airspeed table instead of emerging from blade element theory. For
  hover and low-speed control work that is immaterial; revisit before trusting
  cruise or transition results.

  CALIBRATION
  ================
  ROTOR_TMAX_LBS below is the single number to replace with thrust-stand data:
  it is the static thrust ONE rotor makes at full throttle. 1.874 lbf = 850 g,
  which for this airframe is exactly 2:1 thrust-to-weight.

  TILT CONVENTION
  ================
  fcs/tilt-cmd-rad[N] = 0 means rotors UP (thrust along body -Z, hover).
  +pi/2 means rotors FORWARD (thrust along body +X). This matches the FC's
  neutral servo angle of 0 rad (see drivers/servo/sim.c, centre 1500 us),
  so bridge.py passes the FC's servo angle through unmodified.
-->
<fdm_config name="tiltrotor" version="2.0" release="ALPHA">

  <fileheader>
    <author> Flapjack HIL </author>
    <description> Twin tilt-rotor, external-reaction propulsion, for SIL control development </description>
  </fileheader>

  <metrics>
    <wingarea  unit="M2"> 0.20 </wingarea>
    <wingspan  unit="M">  0.50 </wingspan>
    <chord     unit="M">  0.40 </chord>
    <location name="AERORP" unit="M"> <x>0.0</x> <y>0.0</y> <z>0.0</z> </location>
  </metrics>

  <mass_balance>
    <!-- Inertias are ESTIMATES, not measured: two ~70 g rotor assemblies at
         y = +/-0.25 m dominate roll and yaw (2 * 0.07 * 0.25^2 = 0.0088), with a
         ~0.71 kg central body adding the rest. Pitch is smaller because the
         rotors sit on the lateral axis and barely contribute to Iyy.
         Replace with a bifilar-pendulum measurement when you have one. -->
    <ixx unit="KG*M2"> 0.012 </ixx>
    <iyy unit="KG*M2"> 0.008 </iyy>
    <izz unit="KG*M2"> 0.014 </izz>
    <emptywt unit="KG"> 0.85 </emptywt>
    <location name="CG" unit="M"> <x>0.0</x> <y>0.0</y> <z>0.0</z> </location>
  </mass_balance>

  <!--
       GEAR GEOMETRY
       =============
       <location> here is the STRUCTURAL frame: +X aft, +Y right, +Z up - the
       opposite sense in X and Z to the body FRD frame used everywhere else.
       So structural x = -0.15 is 0.15 m FORWARD of the CG, and z = -0.10 puts
       the contact 0.10 m below it.

       The contacts must straddle the CG in X. They previously did not: both
       mains sat at x = 0, exactly on the CG station, with a single contact
       0.25 m away carrying an unbalanced moment. With Iyy = 0.008 kg*m2 a few
       newtons at that arm is ~1100 rad/s2, so the model picked up ~2.8 rad/s of
       pitch rate in ONE 2.5 ms step on contact and integrated straight to NaN -
       from as little as a 0.5 ft drop, not just the 50 ft case. Mains ahead of
       the CG and a tailwheel behind it makes the standing attitude statically
       determinate.

       Stiffness is sized for THIS airframe (0.85 kg / 1.874 lbf) and given in
       JSBSim's native LBS/FT, not N/M: 25 lbf/ft per contact puts the static
       deflection near 10 mm and the heave mode at ~6 Hz, which 400 Hz resolves
       comfortably. Damping 1.5 lbf/(ft/s) per contact is just past critical, so
       a touchdown settles instead of bouncing.
  -->
  <ground_reactions>
    <contact type="BOGEY" name="LEFT">
      <location unit="M"> <x>-0.15</x> <y>-0.25</y> <z>-0.10</z> </location>
      <static_friction>  0.8 </static_friction>
      <dynamic_friction> 0.5 </dynamic_friction>
      <spring_coeff  unit="LBS/FT">      25 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 1.5 </damping_coeff>
    </contact>
    <contact type="BOGEY" name="RIGHT">
      <location unit="M"> <x>-0.15</x> <y>0.25</y> <z>-0.10</z> </location>
      <static_friction>  0.8 </static_friction>
      <dynamic_friction> 0.5 </dynamic_friction>
      <spring_coeff  unit="LBS/FT">      25 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 1.5 </damping_coeff>
    </contact>
    <contact type="BOGEY" name="TAIL">
      <location unit="M"> <x>0.25</x> <y>0.0</y> <z>-0.10</z> </location>
      <static_friction>  0.8 </static_friction>
      <dynamic_friction> 0.5 </dynamic_friction>
      <spring_coeff  unit="LBS/FT">      25 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 1.5 </damping_coeff>
    </contact>
  </ground_reactions>

  <!-- Declared BEFORE flight_control so the magnitude properties exist when the
       FCS channels below bind their outputs to them.

       Each rotor's thrust is decomposed onto two fixed body-axis forces, up and
       forward, because an external force's <direction> is static. The FCS scales
       them by cos(tilt) and sin(tilt), which rotates the resultant. Applying both
       at the rotor's location gives the roll/yaw moments for free.

       ROTOR HEIGHT (z = +0.06) - ESTIMATE, measure this.
       Structural +Z is UP, so this puts the rotor plane 60 mm above the CG.
       That offset is what gives collective tilt its pitch moment, and it is
       exactly what the firmware mixer assumes (g_TiltServoMix in
       tasks/control/mixer.c pitches by tilting both rotors together).

       It used to be 0.0 - both rotors coincident with the CG in X and Z - so
       neither thrust component had any moment arm about Y and the pitch axis
       was completely uncontrollable: 0.3 rad of collective tilt held for 0.5 s
       produced exactly 0.00000 rad/s of pitch rate. With 60 mm it produces
       -8.92 rad/s, i.e. nose DOWN for rotors tilted forward, which is the sign
       the mixer's -1.0 pitch weight expects. Differential tilt still yaws with
       no pitch cross-coupling.

       60 mm is a plausible number for this airframe, NOT a measured one - the
       repo has no airframe CAD. Pitch response scales linearly with it, so
       replace it with the real rotor-plane height before trusting any pitch
       tuning done in the SIL. Same status as ROTOR_TMAX_LBS above.

       Yaw authority is large against izz = 0.014 (0.3 rad differential gives
       ~22 rad/s), but that is the real geometry - the rotors are 0.25 m out on
       the lateral axis. The controller never commands tilt that big. -->
  <external_reactions>
    <force name="rotor0_up" frame="BODY" unit="LBS">
      <location unit="M"> <x>0.0</x> <y>-0.25</y> <z>0.06</z> </location>
      <direction> <x>0.0</x> <y>0.0</y> <z>-1.0</z> </direction>
    </force>
    <force name="rotor0_fwd" frame="BODY" unit="LBS">
      <location unit="M"> <x>0.0</x> <y>-0.25</y> <z>0.06</z> </location>
      <direction> <x>1.0</x> <y>0.0</y> <z>0.0</z> </direction>
    </force>
    <force name="rotor1_up" frame="BODY" unit="LBS">
      <location unit="M"> <x>0.0</x> <y>0.25</y> <z>0.06</z> </location>
      <direction> <x>0.0</x> <y>0.0</y> <z>-1.0</z> </direction>
    </force>
    <force name="rotor1_fwd" frame="BODY" unit="LBS">
      <location unit="M"> <x>0.0</x> <y>0.25</y> <z>0.06</z> </location>
      <direction> <x>1.0</x> <y>0.0</y> <z>0.0</z> </direction>
    </force>
  </external_reactions>

  <flight_control name="tiltrotor FCS">
    <!-- Both pairs are written by bridge.py from the FC's MotorCmd / ServoCmd.
         They must be declared here: JSBSim normally creates throttle-cmd-norm
         per engine, and this model has no <propulsion> section at all. -->
    <property value="0.0"> fcs/throttle-cmd-norm[0] </property>
    <property value="0.0"> fcs/throttle-cmd-norm[1] </property>
    <!-- Tilt: 0 = rotors up (hover), +pi/2 = rotors forward. -->
    <property value="0.0"> fcs/tilt-cmd-rad[0] </property>
    <property value="0.0"> fcs/tilt-cmd-rad[1] </property>

    <channel name="propulsion">
      <!-- Static thrust per rotor, then de-rated with airspeed.
           Thrust is LINEAR in throttle so hover lands exactly at 0.5, matching
           the hover-throttle default in bridge.py. Real ESC/motor/prop curves sit
           between linear and quadratic; substitute a measured table here.
           The airspeed table uses total airspeed rather than the component along
           the thrust axis - a simplification that is conservative (any motion
           de-rates thrust) and immaterial near hover. JSBSim clamps table
           lookups at their endpoints, so thrust simply floors at zero. -->
      <fcs_function name="fcs/rotor0-thrust">
        <function>
          <product>
            <value> 1.874 </value>
            <property> fcs/throttle-cmd-norm[0] </property>
            <table>
              <independentVar lookup="row"> velocities/vt-fps </independentVar>
              <tableData>
                 0.0   1.00
                16.4   0.90
                32.8   0.75
                49.2   0.55
                65.6   0.30
                82.0   0.00
              </tableData>
            </table>
          </product>
        </function>
        <output> fcs/rotor0-thrust-lbs </output>
      </fcs_function>

      <fcs_function name="fcs/rotor1-thrust">
        <function>
          <product>
            <value> 1.874 </value>
            <property> fcs/throttle-cmd-norm[1] </property>
            <table>
              <independentVar lookup="row"> velocities/vt-fps </independentVar>
              <tableData>
                 0.0   1.00
                16.4   0.90
                32.8   0.75
                49.2   0.55
                65.6   0.30
                82.0   0.00
              </tableData>
            </table>
          </product>
        </function>
        <output> fcs/rotor1-thrust-lbs </output>
      </fcs_function>

      <!-- Rotate each rotor's thrust by its tilt angle. -->
      <fcs_function name="fcs/rotor0-up-cmd">
        <function>
          <product>
            <property> fcs/rotor0-thrust-lbs </property>
            <cos> <property> fcs/tilt-cmd-rad[0] </property> </cos>
          </product>
        </function>
        <output> external_reactions/rotor0_up/magnitude </output>
      </fcs_function>

      <fcs_function name="fcs/rotor0-fwd-cmd">
        <function>
          <product>
            <property> fcs/rotor0-thrust-lbs </property>
            <sin> <property> fcs/tilt-cmd-rad[0] </property> </sin>
          </product>
        </function>
        <output> external_reactions/rotor0_fwd/magnitude </output>
      </fcs_function>

      <fcs_function name="fcs/rotor1-up-cmd">
        <function>
          <product>
            <property> fcs/rotor1-thrust-lbs </property>
            <cos> <property> fcs/tilt-cmd-rad[1] </property> </cos>
          </product>
        </function>
        <output> external_reactions/rotor1_up/magnitude </output>
      </fcs_function>

      <fcs_function name="fcs/rotor1-fwd-cmd">
        <function>
          <product>
            <property> fcs/rotor1-thrust-lbs </property>
            <sin> <property> fcs/tilt-cmd-rad[1] </property> </sin>
          </product>
        </function>
        <output> external_reactions/rotor1_fwd/magnitude </output>
      </fcs_function>
    </channel>
  </flight_control>

  <aerodynamics>
    <!-- Minimal bluff-body drag so the model is well-posed; no lift surfaces. -->
    <axis name="DRAG">
      <function name="aero/force/drag">
        <description> simple parasitic drag </description>
        <product>
          <property> aero/qbar-psf </property>
          <value> 0.30 </value>   <!-- ~ area * Cd, TODO tune -->
        </product>
      </function>
    </axis>
  </aerodynamics>

  <!--
    Sensor models, vendored from JSBSim's own systems/ into ../../systems/.
    <system file> resolves against the FDM root, not the installed package, so
    they have to live in-tree; vendoring also pins them against a JSBSim upgrade.

    Each publishes both sensor/<x>/<field>_true_* and a post-error
    sensor/<x>/<field>, so the bridge can send the corrupted measurement and
    assert against truth from the same run. Shipped with noise/bias/drift/lag
    all zero - turn them on there, not here.

    SensorImu is deliberately NOT included. Its accelerometer reports specific
    force with the opposite Z sign to this project's convention (measured -9.80
    resting, sim.proto specifies +9.81), and its magnetometer disagrees with
    WMM both in Z sign and magnitude (32.2 uT against ~48 uT real). bridge.py's
    synthesize_sensors() stays the source for accel/gyro/mag.
  -->
  <system file="SensorBaro"/>
  <system file="SensorGps"/>

</fdm_config>
