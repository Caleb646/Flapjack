// Flapjack single-core CM7 overlay on Renode's shipped STM32H7 platform.
//
// Extends platforms/cpus/stm32h747.repl (resolved against Renode's install dir)
// rather than redefining it: the upstream memory map already matches
// Firmware/platform/stm32h747/cm7/cm7_flash.ld exactly.
//
// See SilResearch.md §2 for why each entry below is here.

using "platforms/cpus/stm32h747.repl"

// --- Clock tree -------------------------------------------------------------
// The firmware runs SYSCLK from HSI at 64 MHz (platform.c: SYSCLKSource =
// RCC_SYSCLKSOURCE_HSI; the PLL is configured but never selected). Renode's
// STM32H7_RCC does not model the D1/D2/D3 prescaler registers, so the HAL reads
// them back as 0 (div1) and computes 64 MHz for HCLK/PCLK1/PCLK2. The upstream
// .repl assumes a PLL-driven 400/250/200 MHz tree, which would run the FreeRTOS
// tick 6.25x fast and the HAL timebase 3.9x fast. Pin them to what the HAL
// believes.

nvic:
    systickFrequency: 64000000

timer16:                        // HAL timebase (stm32h7xx_hal_timebase_tim.c)
    frequency: 64000000

usart1:                         // debug log / sim link
    frequency: 64000000

usart2:                         // NMEA GPS receiver (BRD_GET_UART_ID(GPS))
    frequency: 64000000

usart3:                         // CRSF RC receiver (BRD_GET_UART_ID(RX))
    frequency: 64000000

// --- DWT --------------------------------------------------------------------
// core_shared.c GetMicroseconds() reads DWT->CYCCNT. The model exists upstream
// but is not wired into the H7 platform; without it CYCCNT reads 0 and
// microsecond timing collapses to 1 ms granularity.

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 64000000

// --- SPI --------------------------------------------------------------------
// Spi_InitSystem() runs unconditionally from main() and touches SPI1/3/5, which
// stm32h7.repl leaves as bare Tags. The STM32H7_SPI model already exists, so
// give them real instances rather than letting HAL_SPI_Init poke at tags.

spi1: SPI.STM32H7_SPI @ sysbus 0x40013000
spi3: SPI.STM32H7_SPI @ sysbus 0x40003C00
spi5: SPI.STM32H7_SPI @ sysbus 0x40015000

// --- IMU --------------------------------------------------------------------
// BMI323 on SPI1, chip select on PC4 (IMU_SPI_NSS_GPIO_* in
// target/flapjack_v1/flapjack_v1.h). The model is compiled at load time from
// Scripts/renode/BMI323.cs, which flapjack_sil.resc includes before this file.
//
// STM32H7_SPI is a NullRegistrationPointPeripheralContainer, so it takes
// exactly one child - fine here, SPI1 has only the IMU. SPI5 carries two, and
// hangs them off an SPI.SPIMultiplexer below.

bmi323: Sensors.BMI323 @ spi1
    port: 4010
    IRQ -> gpioPortC@5
    // INT1 -> PC5 (IMU_INT_GPIO_* in target/flapjack_v1/flapjack_v1.h). The
    // port forwards pin 5 to syscfg#2@5 upstream, so this reaches EXTI line 5
    // and EXTI9_5_IRQn without anything further here.

// Keep the syscfg/EXTI path for PC4 and fan the same pin out to the IMU's chip
// select; the driver drives it with HAL_GPIO_WritePin (SPI_NSS_SOFT).
gpioPortC:
    4 -> syscfg#2@4 | bmi323@0

// --- Mag + baro -------------------------------------------------------------
// MMC5983MA and BMP390 share SPI5 on separate chip selects (mag PF4, baro PF6 -
// MAG_/BARO_SPI_NSS_GPIO_* in target/flapjack_v1/flapjack_v1.h). STM32H7_SPI
// holds exactly one child, so the mux is what turns two CS lines into a device
// select. Its registration address is the GPIO index it answers to.
//
// The mux also solves for these two the framing problem BMI323.cs has to solve
// for itself. It is constructed with suppressExplicitFinishTransmission, so the
// FinishTransmission STM32H7_SPI raises at the end of every TSIZE burst - i.e.
// between a register address and its data, since drivers/bus/spi.c puts both
// inside one CS assertion - is swallowed, and the child sees exactly one, on CS
// release. So those two models delimit transactions on FinishTransmission and
// take no chip-select GPIO of their own.
//
// Compiled at load time from Scripts/renode/MMC5983.cs and BMP390.cs, which
// flapjack_sil.resc includes before this file.

spi5Mux: SPI.SPIMultiplexer @ spi5
    init:
        SetActiveLow 0
        SetActiveLow 1

mmc5983: Sensors.MMC5983 @ spi5Mux 0x0
    port: 4011

bmp390: Sensors.BMP390 @ spi5Mux 0x1
    port: 4012

// PF4 and PF6 are plain GPIO chip selects on this board, driven by hand
// (SPI_NSS_SOFT). Overriding pin 6 drops the upstream `6 -> timer16@00` AF
// mapping from stm32h7.repl, which is deliberate: nothing here uses TIM16_CH1
// input capture, and timer16 is the HAL timebase, so a chip select toggling
// into it is noise the timebase does not need. syscfg keeps the EXTI path, as
// for the IMU's PC4 above.
gpioPortF:
    4 -> syscfg#5@4 | spi5Mux@0
    6 -> syscfg#5@6 | spi5Mux@1
